      Runtime_Net/crypto/*.o \
      Runtime_Net/sys_tls13/*.o \
      Runtime_Net/lib_tls13/*.o \
      Runtime_Net/Software/*.o

# 1. Compilação dos Módulos de Criptografia (Runtime_Net/crypto)
gcc -O3 -msse3 -m64 -ffreestanding -fno-stack-protector -fno-pie -Isystem -I. -IRuntime_Net/crypto -c Runtime_Net/crypto/hkdf.c -o Runtime_Net/crypto/hkdf.o
gcc -O3 -msse3 -m64 -ffreestanding -fno-stack-protector -fno-pie -Isystem -I. -IRuntime_Net/crypto -c Runtime_Net/crypto/rsa_verify.c -o Runtime_Net/crypto/rsa_verify.o
gcc -O3 -msse3 -m64 -ffreestanding -fno-stack-protector -fno-pie -Isystem -I. -IRuntime_Net/crypto -c Runtime_Net/crypto/ec256.c -o Runtime_Net/crypto/ec256.o
gcc -O3 -msse3 -m64 -ffreestanding -fno-stack-protector -fno-pie -Isystem -I. -IRuntime_Net/crypto -c Runtime_Net/crypto/rng.c -o Runtime_Net/crypto/rng.o
gcc -O3 -msse3 -m64 -ffreestanding -fno-stack-protector -fno-pie -Isystem -I. -IRuntime_Net/crypto -c Runtime_Net/crypto/aes_gcm.c -o Runtime_Net/crypto/aes_gcm.o
gcc -O3 -msse3 -m64 -ffreestanding -fno-stack-protector -fno-pie -Isystem -I. -IRuntime_Net/crypto -c Runtime_Net/crypto/x25519.c -o Runtime_Net/crypto/x25519.o
gcc -O3 -msse3 -m64 -ffreestanding -fno-stack-protector -fno-pie -Isystem -I. -IRuntime_Net/crypto -c Runtime_Net/crypto/sha256.c -o Runtime_Net/crypto/sha256.o
gcc -O3 -msse3 -m64 -ffreestanding -fno-stack-protector -fno-pie -Isystem -I. -IRuntime_Net/crypto -c Runtime_Net/crypto/hmac.c -o Runtime_Net/crypto/hmac.o

# 2. Compilação do Core TLS 1.3 (Runtime_Net/Core_tls13)
gcc -O3 -msse3 -m64 -ffreestanding -fno-stack-protector -fno-pie -Isystem -I. -IRuntime_Net/crypto -IRuntime_Net/Core_tls13 -c Runtime_Net/Core_tls13/tls13.c -o Runtime_Net/Core_tls13/tls13.o
gcc -O3 -msse3 -m64 -ffreestanding -fno-stack-protector -fno-pie -Isystem -I. -IRuntime_Net/crypto -IRuntime_Net/Core_tls13 -c Runtime_Net/Core_tls13/tls13_record.c -o Runtime_Net/Core_tls13/tls13_record.o
gcc -O3 -msse3 -m64 -ffreestanding -fno-stack-protector -fno-pie -Isystem -I. -IRuntime_Net/crypto -IRuntime_Net/Core_tls13 -c Runtime_Net/Core_tls13/tls13_handshake.c -o Runtime_Net/Core_tls13/tls13_handshake.o
gcc -O3 -msse3 -m64 -ffreestanding -fno-stack-protector -fno-pie -Isystem -I. -IRuntime_Net/crypto -IRuntime_Net/Core_tls13 -c Runtime_Net/Core_tls13/tls13_crypto.c -o Runtime_Net/Core_tls13/tls13_crypto.o

# 3. Compilação da Camada Sys TLS 1.3 (Runtime_Net/sys_tls13)
gcc -O3 -msse3 -m64 -ffreestanding -fno-stack-protector -fno-pie -Isystem -I. -IRuntime_Net/crypto -IRuntime_Net/Core_tls13 -IRuntime_Net/sys_tls13 -c Runtime_Net/sys_tls13/sys_tls13.c -o Runtime_Net/sys_tls13/sys_tls13.o

# 4. Ligação Parcial (Gera o objeto unificado em lib_tls13)
ld -r Runtime_Net/crypto/hkdf.o \
      Runtime_Net/crypto/rsa_verify.o \
      Runtime_Net/crypto/ec256.o \
      Runtime_Net/crypto/rng.o \
      Runtime_Net/crypto/aes_gcm.o \
      Runtime_Net/crypto/x25519.o \
      Runtime_Net/crypto/sha256.o \
      Runtime_Net/crypto/hmac.o \
      Runtime_Net/Core_tls13/tls13.o \
      Runtime_Net/Core_tls13/tls13_record.o \
      Runtime_Net/Core_tls13/tls13_handshake.o \
      Runtime_Net/sys_tls13/sys_tls13.o \
      Runtime_Net/Core_tls13/tls13_crypto.o \
      -o Runtime_Net/lib_tls13/tls13_engine.o


